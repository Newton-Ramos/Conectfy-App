# =============================================================================
# Variáveis de ambiente — Conectfy backend (NestJS + TypeORM + PostgreSQL)
# Copie para .env (local) ou configure no Render (Environment).
# =============================================================================

# --- Obrigatórias em produção (Render Web Service) ---
NODE_ENV=production
# Render define PORT automaticamente no runtime (não precisa colar no painel).
DATABASE_URL=postgresql://user:pass@host:5432/dbname
JWT_SECRET=substitua-por-string-aleatoria-com-pelo-menos-16-caracteres

# CORS: origens extras (HTTPS), separadas por vírgula. Mobile nativo costuma não enviar Origin.
# Para Expo web / domínios próprios, inclua aqui (ex.: https://meuapp.expo.dev).
CORS_ORIGIN=https://seu-frontend.example.com

# Primeiro deploy sem migrations: true uma vez para criar tabelas; depois false ou remova.
TYPEORM_SYNC=false

# Opcional
# JWT_EXPIRES_IN=7d
# CORS_ALLOW_EXPO_HOSTS=false

# --- Banco local (quando NÃO usa DATABASE_URL) ---
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_NAME=conectfy

# --- OAuth (opcional) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_IOS_CLIENT_ID=
# GOOGLE_ANDROID_CLIENT_ID=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=

# --- E-mail (opcional) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=
# APP_PUBLIC_URL=https://seu-backend.onrender.com

# PASSWORD_RESET_RETURN_TOKEN=false
