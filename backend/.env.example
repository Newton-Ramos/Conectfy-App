PORT=3333

# Origens permitidas no CORS (separadas por vírgula). Em dev o main.ts já inclui localhost:3000/3001 e Expo web.
# CORS_ORIGIN=http://localhost:3000,https://seu-dominio.com

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=sua_senha
DB_NAME=conectfy

# JWT
JWT_SECRET=seu_secret_super_seguro_aqui
JWT_EXPIRES_IN=24h

# Recuperação de senha
# Em produção: defina false e configure SMTP abaixo para enviar o link por e-mail.
# Em dev: se não usar SMTP, o backend devolve resetToken no JSON (NODE_ENV !== production ou esta flag true).
PASSWORD_RESET_RETURN_TOKEN=true

# Opcional — envio do link por e-mail (Gmail/Outlook/SendGrid/SMTP da hospedagem)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu-email@gmail.com
# SMTP_PASS=senha-de-app
# MAIL_FROM=Conectfy <noreply@seudominio.com>
# URL pública do frontend (link no e-mail)
# APP_PUBLIC_URL=http://localhost:3000

# Google (OAuth) — ID Web no console Google Cloud; opcional iOS/Android para mobile
GOOGLE_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Facebook — Graph API
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Instagram Basic Display — OAuth em Meta for Developers
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
