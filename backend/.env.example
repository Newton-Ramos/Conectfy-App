# =============================================================================
# Variáveis de ambiente — Conectfy backend (NestJS + TypeORM + PostgreSQL)
# Copie para .env (não commitar .env). No Render, configure no Environment.
# =============================================================================

PORT=3333
NODE_ENV=development

# --- Banco: prioridade DATABASE_URL (TypeORM + Nest) ---

# Render — External URL: use no seu PC (Cursor, npm run migration:run, db:validate).
# Cole a URL completa do painel Postgres → "External Database URL".
# Formato típico (valores fictícios):
# DATABASE_URL=postgresql://USUARIO:SENHA@dpg-xxxx.region.render.com:5432/NOME_DO_BANCO

# Render — Web Service em produção: use a Internal Database URL no painel do serviço
# (mesma região, tráfego privado). Não commite essa URL no repositório.

# --- Banco local (somente se NÃO usar DATABASE_URL) ---
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# ou: DB_USERNAME=postgres
# DB_PASS=postgres
# ou: DB_PASSWORD=postgres
# DB_NAME=conectfy

# --- Obrigatórias em produção (Render Web Service) ---
# NODE_ENV=production
# DATABASE_URL=...
# JWT_SECRET=substitua-por-string-aleatoria-com-pelo-menos-16-caracteres
# CORS_ORIGIN=https://seu-frontend.example.com
# TYPEORM_SYNC=false

# --- Migrations ---
# npm run db:validate
# npm run migration:run
# npm run migration:generate -- src/migrations/NomeDescritivo
# npm run migration:run:prod   (após npm run build; usa dist/src/data-source.js)

# Opcional
# JWT_EXPIRES_IN=7d
# CORS_ALLOW_EXPO_HOSTS=false

# --- OAuth (opcional) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_IOS_CLIENT_ID=
# GOOGLE_ANDROID_CLIENT_ID=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=

# --- E-mail (opcional) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=
# APP_PUBLIC_URL=https://seu-backend.onrender.com

# PASSWORD_RESET_RETURN_TOKEN=false
